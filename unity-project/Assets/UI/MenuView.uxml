                <ui:Label text="Username" name="Username" class="beige-text" style="font-size: 36px; margin-right: 16px;"/>
                <ui:VisualElement name="Avatar" style="flex-grow: 1; border-top-left-radius: 9999px; border-top-right-radius: 9999px; border-bottom-right-radius: 9999px; border-bottom-left-radius: 9999px; width: 96px; height: 96px; background-color: rgb(0, 0, 0);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: center; align-items: center; width: 100%; padding-top: 0; padding-right: 128px; padding-bottom: 64px; padding-left: 128px;">
            <ui:VisualElement name="" style="flex-grow: 1; flex-direction: column; justify-content: center; align-items: flex-start; background-color: rgba(0, 0, 0, 0); height: 100%; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-left: 0; margin-right: 12px; width: 100%;">
                <ui:VisualElement name="PlayerList" style="flex-grow: 1; flex-direction: column; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.39); height: 100%; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; margin-left: 0; width: 100%; margin-bottom: 0;"/>
                <ui:VisualElement name="MemberActions" style="flex-grow: 0; flex-direction: row; display: flex; width: 100%; margin-top: 16px;">
                    <ui:Button text="Leave" name="LeaveButton" class="menu-button beige-text" style="width: auto; margin-top: 0; margin-right: 16px; margin-bottom: 0; margin-left: 0; -unity-font-style: bold; font-size: 36px; flex-grow: 1;"/>
                    <ui:Button text="Ready" name="ReadyButton" class="menu-button beige-text" style="width: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-font-style: bold; font-size: 36px; flex-grow: 1;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="" style="flex-grow: 1; flex-direction: column; justify-content: center; align-items: flex-start; background-color: rgba(0, 0, 0, 0); height: 100%; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-left: 12px; width: 100%;">
                <ui:VisualElement name="Rules" style="flex-grow: 1; flex-direction: column; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.39); height: 100%; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; margin-left: 0; width: 100%; margin-bottom: 0;"/>
                <ui:VisualElement name="HostActions" style="flex-grow: 0; flex-direction: row; display: flex; width: 100%; margin-top: 16px;">
