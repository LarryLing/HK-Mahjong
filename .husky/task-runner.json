{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "csharpier-format",
      "command": "dotnet",
      "args": ["csharpier", "format", "${staged}"],
      "include": ["unity-project/**/*.cs"]
    },
    {
      "name": "dotnet-lint",
      "command": "dotnet",
      "args": [
        "format",
        "unity-project/HK-Mahjong.slnx",
        "analyzers",
        "--verify-no-changes",
        "--verbosity",
        "normal"
      ],
      "include": ["unity-project/**/*.cs"]
    }
  ]
}
